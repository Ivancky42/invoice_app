# Production on Vercel: create a Blob store (Storage → Blob); BLOB_READ_WRITE_TOKEN is injected automatically.
# Logos require this on Vercel — the server filesystem is not writable for persisted uploads.
# BLOB_READ_WRITE_TOKEN=

# Local Postgres — used by prisma.config.ts (CLI) + pg adapter at runtime on the server
# On Neon (Vercel prod): Set DATABASE_URL to the pooled connection for the app runtime.
# Set DIRECT_DATABASE_URL to Neon’s non-pooled "direct" host for prisma.config.ts —
# migrations run at build (`pnpm build` → prisma migrate deploy) and are safer with direct.
# Migrate deploy applies only pending SQL migrations; it does NOT reset or wipe tables.
#
# If Vercel build fails with Prisma P3005 ("database schema is not empty"), Neon had tables
# before Migrate history existed (e.g. old db push). Fix once from your machine with prod URL:
#   pnpm db:resolve-baseline-prod
# If "DailyLog" already exists on Neon, also: pnpm db:resolve-daily-log-prod
# Then: pnpm db:migrate-prod   (or redeploy; `pnpm build` runs migrate deploy)
# DIRECT_DATABASE_URL=
DATABASE_URL="postgresql://invoice:invoice@localhost:5433/invoice_app?schema=public"

# Optional: unlock whole app with a 6-digit PIN (no gate if unset or invalid)
# APP_PIN must be exactly six digits (e.g. 042917). Leading zeros allowed.
APP_PIN=

# Signing secret for the PIN session cookie — long random string, NOT the PIN.
# At least 16 characters. Required when APP_PIN is set.
APP_GATE_SECRET=

# === Stock dashboard (Neon SoT; Notion sync legacy/frozen) ===
# Notion integration vars kept for emergency re-pull during the Phase 5 go-back window.
# Internal Integration Token from https://www.notion.so/my-integrations (starts with `secret_` or `ntn_`).
# Each database below must be shared with this integration: in Notion, open the DB ▸ ••• ▸ Connections ▸ add the integration.
NOTION_TOKEN=
NOTION_PORTFOLIO_DB=
NOTION_WATCHLIST_DB=
NOTION_TRADES_DB=
NOTION_TRENDS_DB=
NOTION_IDEAS_DB=
NOTION_DAILY_LOG_DB=
# Child-page parent for weekly stock reports + monthly macro surveys (Ivan's Stock Monitor HQ page ID).
NOTION_STOCK_HQ_PAGE_ID=

# Optional emergency re-enable of Notion→Neon sync during the ~2-week go-back window.
# When unset or not exactly "true", GET /api/sync/notion and manualSyncNotion return frozen/503.
# Leave unset in normal operation (Neon is SoT; agents write via MCP).
# NOTION_SYNC_ENABLED=

# Shared secret to authorise manual Notion sync calls: GET /api/sync/notion?secret=$SYNC_SECRET
# (Only useful when NOTION_SYNC_ENABLED=true.) Vercel Cron uses CRON_SECRET for /api/sync/prices.
SYNC_SECRET=
# CRON_SECRET=

# Agent / MCP Bearer token for /api/agent/* and /api/mcp/* (distinct from SYNC_SECRET).
# Long random secret, 32+ chars. Required for Stock HQ agent read (Phase 4b) and writes (4c).
AGENT_TOKEN=

# Finnhub → Neon Portfolio/Watchlist/Ideas (**currentPrice** / portfolio **lastPriceUpdate**), then portfolio snapshot.
# Cron: GET /api/sync/prices daily 22:00 UTC (= 06:00 GMT+8). Notion→Neon cron removed (Phase 5).
FINNHUB_API_KEY=

# EODHD — **CSPX** (LSE `CSPX.LSE`) only; Finnhub has no quote for this ticker. Written to Neon Portfolio (not Notion).
EODHD_API_KEY=

# === Stock HQ Config (Phase 3) ===
# Live config (cash, FX, limits, sentiment/earnings thresholds, tracked tickers) lives in Neon
# table `Config` — seed with `npx tsx scripts/seed-config.ts`. No env vars required for Config itself.
# Agent/rules prose lives in git `/prompts/*.md` (not env, not Config).
