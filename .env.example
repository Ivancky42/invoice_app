# Production on Vercel: create a Blob store (Storage → Blob); BLOB_READ_WRITE_TOKEN is injected automatically.
# Logos require this on Vercel — the server filesystem is not writable for persisted uploads.
# BLOB_READ_WRITE_TOKEN=

# Local Postgres — used by prisma.config.ts (CLI) + pg adapter at runtime on the server
# On Neon (Vercel prod): Set DATABASE_URL to the pooled connection for the app runtime.
# Set DIRECT_DATABASE_URL to Neon’s non-pooled "direct" host for prisma.config.ts —
# migrations run at build (`pnpm build` → prisma migrate deploy) and are safer with direct.
# Migrate deploy applies only pending SQL migrations; it does NOT reset or wipe tables.
#
# If Vercel build fails with Prisma P3005 ("database schema is not empty"), Neon had tables
# before Migrate history existed (e.g. old db push). Fix once from your machine with prod URL:
#   pnpm db:resolve-baseline-prod
# If "DailyLog" already exists on Neon, also: pnpm db:resolve-daily-log-prod
# Then: pnpm db:migrate-prod   (or redeploy; `pnpm build` runs migrate deploy)
# DIRECT_DATABASE_URL=
DATABASE_URL="postgresql://invoice:invoice@localhost:5433/invoice_app?schema=public"

# Optional: unlock whole app with a 6-digit PIN (no gate if unset or invalid)
# APP_PIN must be exactly six digits (e.g. 042917). Leading zeros allowed.
APP_PIN=

# Signing secret for the PIN session cookie — long random string, NOT the PIN.
# At least 16 characters. Required when APP_PIN is set.
APP_GATE_SECRET=

# === Stock dashboard (Notion-cached) ===
# Internal Integration Token from https://www.notion.so/my-integrations (starts with `secret_` or `ntn_`).
# Each database below must be shared with this integration: in Notion, open the DB ▸ ••• ▸ Connections ▸ add the integration.
NOTION_TOKEN=
NOTION_PORTFOLIO_DB=
NOTION_WATCHLIST_DB=
NOTION_TRADES_DB=
NOTION_TRENDS_DB=
NOTION_IDEAS_DB=
NOTION_DAILY_LOG_DB=

# Shared secret to authorise manual sync calls: GET /api/sync/notion?secret=$SYNC_SECRET
# Vercel Cron uses CRON_SECRET (auto-injected as `Authorization: Bearer …`); set both in production.
SYNC_SECRET=
# CRON_SECRET=

# Finhub → Notion (**Current Price** / portfolio **Last Price Update**). Crons: hourly UTC :00; Notion→Neon at UTC :05 (= :00 / :05 GMT+8). Manual button does not refresh Neon — use **Sync now** after if needed.
FINNHUB_API_KEY=
