{
  "name": "invoice-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push && prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "start:all": "pnpm db:up && pnpm db:push && pnpm dev",
    "db:resolve-baseline-prod": "prisma migrate resolve --applied 20250514190000_baseline --config prisma.config.ts",
    "db:resolve-daily-log-prod": "prisma migrate resolve --applied 20250514190100_daily_log --config prisma.config.ts",
    "db:resolve-portfolio-snapshot-breakdown-prod": "prisma migrate resolve --applied 20250527150000_portfolio_snapshot_breakdown --config prisma.config.ts",
    "db:repair-prod-migrations": "prisma migrate resolve --applied 20250527150000_portfolio_snapshot_breakdown --config prisma.config.ts && prisma migrate deploy --config prisma.config.ts",
    "db:migrate-prod": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@notionhq/client": "^5.21.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-select": "^2.3.0",
    "@react-pdf/renderer": "^4.1.5",
    "@vercel/blob": "^2.3.3",
    "@vercel/functions": "^3.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "mcp-handler": "1.1.0",
    "next": "16.2.4",
    "pg": "^8.16.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "postcss": "^8.4.49",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <23 || >=24.0.0"
  }
}
