{
  "name": "invoice-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push && prisma generate && npx tsx scripts/apply-raw-constraints.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "start:all": "pnpm db:up && pnpm db:push && pnpm dev",
    "db:resolve-baseline-prod": "prisma migrate resolve --applied 20250514190000_baseline --config prisma.config.ts",
    "db:resolve-daily-log-prod": "prisma migrate resolve --applied 20250514190100_daily_log --config prisma.config.ts",
    "db:resolve-portfolio-snapshot-breakdown-prod": "prisma migrate resolve --applied 20250527150000_portfolio_snapshot_breakdown --config prisma.config.ts",
    "db:repair-prod-migrations": "prisma migrate resolve --applied 20250527150000_portfolio_snapshot_breakdown --config prisma.config.ts && prisma migrate deploy --config prisma.config.ts",
    "db:resolve-cron-job-ledger-prod": "prisma migrate resolve --applied 20260808120000_cron_job_ledger --config prisma.config.ts",
    "db:resolve-price-history-prod": "prisma migrate resolve --applied 20260808130000_price_history --config prisma.config.ts",
    "db:resolve-rule-versions-prod": "prisma migrate resolve --applied 20260808140000_rule_versions --config prisma.config.ts",
    "db:resolve-shadow-ledger-prod": "prisma migrate resolve --applied 20260808150000_shadow_ledger --config prisma.config.ts",
    "db:resolve-fitness-prod": "prisma migrate resolve --applied 20260808160000_fitness --config prisma.config.ts",
    "db:resolve-noise-thesis-prod": "prisma migrate resolve --applied 20260808170000_noise_thesis --config prisma.config.ts",
    "db:resolve-evidence-prod": "prisma migrate resolve --applied 20260808180000_evidence --config prisma.config.ts",
    "db:resolve-evolution-prod": "prisma migrate resolve --applied 20260808190000_evolution --config prisma.config.ts",
    "db:migrate-prod": "prisma migrate deploy --config prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@notionhq/client": "^5.30.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-select": "^2.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "mcp-handler": "1.1.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.9",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": "26.x"
  }
}
