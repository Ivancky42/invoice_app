generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  QUOTATION
  INVOICE
  DELIVERY_ORDER
}

enum DocumentStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model CompanyProfile {
  id           String   @id @default(cuid())
  name         String
  address      String
  email        String?
  phone        String?
  registration String?
  taxId        String?
  bankDetails  String?
  logoPath     String?
  currency     String   @default("USD")
  taxRate      Float    @default(0)
  notes        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  documents    Document[]
}

model Document {
  id            String         @id @default(cuid())
  type          DocumentType
  number        String         @unique
  status        DocumentStatus @default(DRAFT)
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  companyId     String?
  company       CompanyProfile? @relation(fields: [companyId], references: [id])
  clientName    String
  clientAddress String?
  clientEmail   String?
  clientPhone   String?
  shipToAttn    String?
  shipToAddress String?
  poNumber             String?
  projectTitle         String?
  projectDescription   String?
  items         Json
  subtotal      Float          @default(0)
  discountType  String         @default("PERCENT")
  discountValue Float          @default(0)
  discountAmount Float         @default(0)
  taxRate       Float          @default(0)
  taxAmount     Float          @default(0)
  total         Float          @default(0)
  paymentTerms  String?
  notes         String?
  terms         String?
  parentId      String?
  parent        Document?      @relation("DocumentLifecycle", fields: [parentId], references: [id])
  children      Document[]     @relation("DocumentLifecycle")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// === Stock dashboard (Notion-cached) ===
// All tables use notionId as primary key for idempotent upserts from the Notion sync.
// Source of truth: Notion. This database is a read cache only — never write back to Notion.

model Portfolio {
  notionId         String    @id
  ticker           String
  company          String?
  currentPrice     Decimal?  @db.Decimal(14, 4)
  myAvgCost        Decimal?  @db.Decimal(14, 4)
  analystTarget    Decimal?  @db.Decimal(14, 4)
  upsidePct        Decimal?  @db.Decimal(8, 4)
  action           String?
  riskLevel        String?
  analystRating    String?
  socialScore      Int?
  socialSentiment  String?
  earningsDate     DateTime?
  daysToEarnings   Int?
  stopLoss         Decimal?  @db.Decimal(14, 4)
  entryZone        String?
  thesis           String?
  sectorTag        String?
  marketCapBucket  String?
  notes            String?
  keyRisk          String?
  beatRate         String?
  impliedMove      String?
  lastPriceUpdate  DateTime?
  syncedAt         DateTime  @updatedAt

  @@index([ticker])
}

model Watchlist {
  notionId         String    @id
  ticker           String
  company          String?
  theme            String?
  sector           String?
  priority         String?
  currentPrice     Decimal?  @db.Decimal(14, 4)
  analystTarget    Decimal?  @db.Decimal(14, 4)
  bullTarget       Decimal?  @db.Decimal(14, 4)
  upsidePct        Decimal?  @db.Decimal(8, 4)
  riskLevel        String?
  analystRating    String?
  socialScore      Int?
  socialPlatformBuzz String?
  earningsDate     DateTime?
  daysToEarnings   Int?
  earningsRisk     String?
  entryZone        String?
  stopLoss         Decimal?  @db.Decimal(14, 4)
  keyCatalyst      String?
  keyRisk          String?
  thesis           String?
  actionNotes      String?
  beatRate         String?
  impliedMove      String?
  analystCount     Int?
  marketCapBucket  String?
  syncedAt         DateTime  @updatedAt

  @@index([ticker])
  @@index([priority])
}

model Trade {
  notionId         String    @id
  title            String
  ticker           String?
  type             String?
  date             DateTime?
  pricePerShare    Decimal?  @db.Decimal(14, 4)
  shares           Decimal?  @db.Decimal(18, 4)
  totalValue       Decimal?  @db.Decimal(18, 4)
  pnlDollar        Decimal?  @db.Decimal(18, 4)
  pnlPct           Decimal?  @db.Decimal(8, 4)
  status           String?
  avgCostBasis     Decimal?  @db.Decimal(14, 4)
  exitReason       String?
  thesisAtEntry    String?
  notes            String?
  syncedAt         DateTime  @updatedAt

  @@index([ticker])
  @@index([date])
  @@index([status])
}

model Trend {
  notionId               String   @id
  trendName              String
  dateDiscovered         DateTime?
  representativeTickers  String?
  themeSector            String?
  lifecycleStage         String?
  signalScore            Int?
  socialVelocity         Int?
  analystMomentum        Int?
  priceClustering        Int?
  fundamentalBacking     Int?
  discoveredVia          String?
  weekMomentum           String?
  perf1m                 Decimal? @db.Decimal(8, 4)
  perf3m                 Decimal? @db.Decimal(8, 4)
  verdict                String?
  similarToPastTrend     String?
  keyCatalyst            String?
  avoidReason            String?
  notes                  String?
  retrospective          String?
  syncedAt               DateTime @updatedAt

  @@index([lifecycleStage])
  @@index([signalScore])
}

model Idea {
  notionId         String    @id
  stockSector      String
  theme            String?
  currentPrice     Decimal?  @db.Decimal(14, 4)
  analystTarget    Decimal?  @db.Decimal(14, 4)
  upsidePct        Decimal?  @db.Decimal(8, 4)
  riskLevel        String?
  status           String?
  socialBuzz       String?
  foundVia         String?
  whyInteresting   String?
  syncedAt         DateTime  @updatedAt

  @@index([status])
}

model SyncStatus {
  id            Int       @id @default(autoincrement())
  source        String    @unique
  lastRunAt     DateTime
  lastSuccessAt DateTime?
  lastError     String?
  rowCounts     Json?
}
