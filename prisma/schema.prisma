generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  QUOTATION
  INVOICE
  DELIVERY_ORDER
}

enum DocumentStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model CompanyProfile {
  id           String   @id @default(cuid())
  name         String
  address      String
  email        String?
  phone        String?
  registration String?
  taxId        String?
  bankDetails  String?
  logoPath     String?
  currency     String   @default("USD")
  taxRate      Float    @default(0)
  notes        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  documents    Document[]
}

model ClientProfile {
  id            String   @id @default(cuid())
  name          String
  address       String?
  email         String?
  phone         String?
  shipToAttn    String?
  shipToAddress String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  documents     Document[]
}

model Document {
  id            String         @id @default(cuid())
  type          DocumentType
  number        String         @unique
  status        DocumentStatus @default(DRAFT)
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  companyId     String?
  company       CompanyProfile? @relation(fields: [companyId], references: [id])
  clientId      String?
  client        ClientProfile? @relation(fields: [clientId], references: [id])
  clientName    String
  clientAddress String?
  clientEmail   String?
  clientPhone   String?
  shipToAttn    String?
  shipToAddress String?
  poNumber             String?
  projectTitle         String?
  projectDescription   String?
  items         Json
  subtotal      Float          @default(0)
  discountType  String         @default("PERCENT")
  discountValue Float          @default(0)
  discountAmount Float         @default(0)
  taxRate       Float          @default(0)
  taxAmount     Float          @default(0)
  total         Float          @default(0)
  paymentTerms  String?
  notes         String?
  terms         String?
  parentId      String?
  parent        Document?      @relation("DocumentLifecycle", fields: [parentId], references: [id])
  children      Document[]     @relation("DocumentLifecycle")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// === Stock dashboard (Notion-cached) ===
// All tables use notionId as primary key for idempotent upserts from the Notion sync.
// Source of truth: Notion. This database is a read cache only — never write back to Notion.

model Portfolio {
  notionId         String    @id
  ticker           String
  company          String?
  currentPrice     Decimal?  @db.Decimal(14, 4)
  myAvgCost        Decimal?  @db.Decimal(14, 4)
  analystTarget    Decimal?  @db.Decimal(14, 4)
  upsidePct        Decimal?  @db.Decimal(8, 4)
  action           String?
  riskLevel        String?
  analystRating    String?
  socialScore      Int?
  socialSentiment  String?
  earningsDate     DateTime?
  daysToEarnings   Int?
  stopLoss         Decimal?  @db.Decimal(14, 4)
  entryZone        String?
  thesis           String?
  sectorTag        String?
  marketCapBucket  String?
  notes            String?
  /// Daily notes from the Notion page body (canonical since Jun 2026).
  pageNotes        String?   @db.Text
  keyRisk          String?
  beatRate         String?
  impliedMove      String?
  lastPriceUpdate  DateTime?
  syncedAt         DateTime  @updatedAt

  @@index([ticker])
}

model Watchlist {
  notionId         String    @id
  ticker           String
  company          String?
  theme            String?
  sector           String?
  priority         String?
  currentPrice     Decimal?  @db.Decimal(14, 4)
  analystTarget    Decimal?  @db.Decimal(14, 4)
  bullTarget       Decimal?  @db.Decimal(14, 4)
  upsidePct        Decimal?  @db.Decimal(8, 4)
  riskLevel        String?
  analystRating    String?
  socialScore      Int?
  socialPlatformBuzz String?
  earningsDate     DateTime?
  daysToEarnings   Int?
  earningsRisk     String?
  entryZone        String?
  stopLoss         Decimal?  @db.Decimal(14, 4)
  keyCatalyst      String?
  keyRisk          String?
  thesis           String?
  actionNotes      String?
  /// Daily notes from the Notion page body (canonical since Jun 2026).
  pageNotes        String?   @db.Text
  beatRate         String?
  impliedMove      String?
  analystCount     Int?
  marketCapBucket  String?
  syncedAt         DateTime  @updatedAt

  @@index([ticker])
  @@index([priority])
}

model Trade {
  notionId         String    @id
  title            String
  ticker           String?
  type             String?
  date             DateTime?
  pricePerShare    Decimal?  @db.Decimal(14, 4)
  shares           Decimal?  @db.Decimal(18, 4)
  totalValue       Decimal?  @db.Decimal(18, 4)
  pnlDollar        Decimal?  @db.Decimal(18, 4)
  pnlPct           Decimal?  @db.Decimal(8, 4)
  status           String?
  avgCostBasis     Decimal?  @db.Decimal(14, 4)
  exitReason       String?
  thesisAtEntry    String?
  notes            String?
  syncedAt         DateTime  @updatedAt

  @@index([ticker])
  @@index([date])
  @@index([status])
}

model Trend {
  notionId               String   @id
  trendName              String
  dateDiscovered         DateTime?
  representativeTickers  String?
  themeSector            String?
  lifecycleStage         String?
  signalScore            Int?
  socialVelocity         Int?
  analystMomentum        Int?
  priceClustering        Int?
  fundamentalBacking     Int?
  discoveredVia          String?
  weekMomentum           String?
  perf1m                 Decimal? @db.Decimal(8, 4)
  perf3m                 Decimal? @db.Decimal(8, 4)
  verdict                String?
  similarToPastTrend     String?
  keyCatalyst            String?
  avoidReason            String?
  notes                  String?
  retrospective          String?
  syncedAt               DateTime @updatedAt

  @@index([lifecycleStage])
  @@index([signalScore])
}

model Idea {
  notionId         String    @id
  stockSector      String
  theme            String?
  currentPrice     Decimal?  @db.Decimal(14, 4)
  analystTarget    Decimal?  @db.Decimal(14, 4)
  upsidePct        Decimal?  @db.Decimal(8, 4)
  riskLevel        String?
  status           String?
  socialBuzz       String?
  foundVia         String?
  whyInteresting   String?
  syncedAt         DateTime  @updatedAt

  @@index([status])
}

/// Cached rows from Notion Daily Logs DB (journal / briefing).
model DailyLog {
  notionId         String    @id
  /// Typically the ISO date (`Name` column), e.g. 2026-05-14
  title            String
  logDate          DateTime?
  actionTaken      String?   @db.Text
  alertEmailSent   Boolean?
  flaggedTickers   String?   @db.Text
  flagsCount       Int?
  marketContext    String?   @db.Text
  notes            String?   @db.Text
  portfolioMove    String?   @db.Text
  topNews          String?   @db.Text
  watchlistMove    String?   @db.Text
  syncedAt         DateTime  @updatedAt

  @@index([logDate])
}

enum StockReportType {
  WEEKLY
  MONTHLY
}

/// Cached weekly / monthly report pages from Notion Stock Monitor HQ (child pages).
model StockReport {
  notionId   String          @id
  title      String
  reportType StockReportType
  reportDate DateTime?
  /// Normalized block tree for rendering (paragraphs, headings, tables, lists).
  content    Json
  syncedAt   DateTime        @updatedAt

  @@index([reportType])
  @@index([reportDate])
}

/// One row per calendar day (GMT+8) — total portfolio value after Notion→Neon sync.
model PortfolioSnapshot {
  /// Noon UTC on the GMT+8 calendar date (matches price-sync day boundary).
  snapshotDate    DateTime @unique
  totalValue      Decimal  @db.Decimal(18, 4)
  /// Equities mark-to-market (incl. CSPX via EODHD price in Notion).
  equitiesValue   Decimal? @db.Decimal(18, 4)
  /// CASH_USD balance from Notion.
  cashValue       Decimal? @db.Decimal(18, 4)
  /// Per-holding values: [{ key, label, value, isCash }, …]
  holdingsBreakdown Json?
  unrealizedPnl   Decimal? @db.Decimal(18, 4)
  /// vs previous snapshot day; null on first row.
  dailyReturnPct  Decimal? @db.Decimal(10, 4)
  recordedAt      DateTime @default(now())

  @@index([snapshotDate])
}

model SyncStatus {
  id            Int       @id @default(autoincrement())
  source        String    @unique
  lastRunAt     DateTime
  lastSuccessAt DateTime?
  lastError     String?
  rowCounts     Json?
}

// === Crypto dashboard (Neon-native, no Notion) ===
// DB is the source of truth. Qualitative fields edited in-app via server actions.

enum CryptoAssetStatus {
  PORTFOLIO
  WATCHLIST
  TRENDING
  ARCHIVED
}

enum CryptoBriefAction {
  BUY
  SELL
  HOLD
  TRIM
  ADD
}

enum CryptoLearningKind {
  DAILY
  WEEKLY
  MONTHLY
}

model CryptoAsset {
  id            String   @id @default(cuid())
  symbol        String   @unique          // "BTC"
  name          String
  coingeckoId   String   @unique          // "bitcoin"
  binanceSymbol String?                    // "BTCUSDT"; null → skip Binance signals
  llamaSlug     String?                    // DeFiLlama chain slug ("Sei")
  status        CryptoAssetStatus @default(WATCHLIST)
  quantity      Decimal? @db.Decimal(24, 10)   // PORTFOLIO only
  avgCost       Decimal? @db.Decimal(18, 8)
  thesis        String?  @db.Text
  notes         String?  @db.Text
  keyCatalyst   String?
  targetPrice   Decimal? @db.Decimal(18, 8)
  stopLoss      Decimal? @db.Decimal(18, 8)
  categories    Json?
  trendingAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  snapshots     CryptoMetricSnapshot[]
  trades        CryptoTrade[]
  @@index([status])
}

model CryptoTrade {
  id        String   @id @default(cuid())
  assetId   String
  asset     CryptoAsset @relation(fields: [assetId], references: [id])
  side      String                         // "BUY" | "SELL"
  quantity  Decimal  @db.Decimal(24, 10)
  price     Decimal  @db.Decimal(18, 8)
  fee       Decimal? @db.Decimal(18, 8)
  tradedAt  DateTime
  notes     String?
  createdAt DateTime @default(now())
  @@index([assetId, tradedAt])
}

/// One row per asset per day; snapshotDate = noon UTC of the GMT+8 date
/// (same day-key convention as PortfolioSnapshot).
model CryptoMetricSnapshot {
  id             String   @id @default(cuid())
  assetId        String
  asset          CryptoAsset @relation(fields: [assetId], references: [id])
  snapshotDate   DateTime
  price          Decimal? @db.Decimal(18, 8)
  marketCap      Decimal? @db.Decimal(24, 2)
  volume24h      Decimal? @db.Decimal(24, 2)
  change24hPct   Decimal? @db.Decimal(10, 4)
  change7dPct    Decimal? @db.Decimal(10, 4)
  athPrice       Decimal? @db.Decimal(18, 8)
  athDrawdownPct Decimal? @db.Decimal(10, 4)
  circulatingPct Decimal? @db.Decimal(8, 4)
  rsi14          Decimal? @db.Decimal(8, 4)
  ma20           Decimal? @db.Decimal(18, 8)
  ma50           Decimal? @db.Decimal(18, 8)
  maCross        String?                    // "GOLDEN" | "DEATH" (within last 3 days)
  volumeSpike    Boolean  @default(false)   // > 2x 30d avg
  beta30dBtc     Decimal? @db.Decimal(8, 4)
  fundingRate    Decimal? @db.Decimal(12, 8)
  openInterest   Decimal? @db.Decimal(24, 2)
  tvl            Decimal? @db.Decimal(24, 2)
  tvlChange7dPct Decimal? @db.Decimal(10, 4)
  flags          Json?                      // ["RSI_OVERSOLD","FUNDING_EXTREME",...]
  createdAt      DateTime @default(now())
  @@unique([assetId, snapshotDate])
  @@index([snapshotDate])
}

model CryptoCatalyst {
  id          String   @id @default(cuid())
  title       String
  url         String   @unique              // dedupe key across runs
  source      String                        // "coindesk" | "cointelegraph" | "theblock" | "decrypt"
  publishedAt DateTime?
  symbols     Json                          // matched tracked symbols
  createdAt   DateTime @default(now())
  @@index([publishedAt])
}

model CryptoDailyBrief {
  id             String   @id @default(cuid())
  briefDate      DateTime @unique
  marketSummary  String   @db.Text
  fearGreed      Int?
  calls          Json     // [{symbol, action, confidence 1-5, reason}]
  watchlistNotes String?  @db.Text
  raw            Json?    // full posted payload for audit
  createdAt      DateTime @default(now())
}

model CryptoLearningLog {
  id          String   @id @default(cuid())
  kind        CryptoLearningKind
  logDate     DateTime
  evaluations Json?    // [{symbol, priorCall, outcomePct, verdict RIGHT|WRONG|NEUTRAL, lesson}]
  heuristics  String?  @db.Text   // current playbook the daily task applies
  summary     String   @db.Text
  createdAt   DateTime @default(now())
  @@unique([kind, logDate])
  @@index([kind, logDate])
}
