generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  QUOTATION
  INVOICE
  DELIVERY_ORDER
}

enum DocumentStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model CompanyProfile {
  id           String   @id @default(cuid())
  name         String
  address      String
  email        String?
  phone        String?
  registration String?
  taxId        String?
  bankDetails  String?
  logoPath     String?
  currency     String   @default("USD")
  taxRate      Float    @default(0)
  notes        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  documents    Document[]
}

model ClientProfile {
  id            String   @id @default(cuid())
  name          String
  address       String?
  email         String?
  phone         String?
  shipToAttn    String?
  shipToAddress String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  documents     Document[]
}

model Document {
  id            String         @id @default(cuid())
  type          DocumentType
  number        String         @unique
  status        DocumentStatus @default(DRAFT)
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  companyId     String?
  company       CompanyProfile? @relation(fields: [companyId], references: [id])
  clientId      String?
  client        ClientProfile? @relation(fields: [clientId], references: [id])
  clientName    String
  clientAddress String?
  clientEmail   String?
  clientPhone   String?
  shipToAttn    String?
  shipToAddress String?
  poNumber             String?
  projectTitle         String?
  projectDescription   String?
  items         Json
  subtotal      Float          @default(0)
  discountType  String         @default("PERCENT")
  discountValue Float          @default(0)
  discountAmount Float         @default(0)
  taxRate       Float          @default(0)
  taxAmount     Float          @default(0)
  total         Float          @default(0)
  paymentTerms  String?
  notes         String?
  terms         String?
  parentId      String?
  parent        Document?      @relation("DocumentLifecycle", fields: [parentId], references: [id])
  children      Document[]     @relation("DocumentLifecycle")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// === Stock dashboard ===
// Source of truth: Neon. Notion sync is legacy/frozen (Phase 5; NOTION_SYNC_ENABLED for go-back).
// Phase 2: cuid primary keys; notionId is optional unique (nullable for agent-created rows).
// Notion sync (when re-enabled) still upserts by notionId.
// Phase 3: Config table holds live cash/FX/limits/thresholds (rules in git /prompts).
// Phase 0a: status-like columns are nullable enums; *Raw strings kept for one release.
// Phase 4+: agents read/write via /api/agent/* and MCP (/api/mcp/mcp).

enum PositionAction {
  HOLD
  ADD_ON_DIP
  REDUCE
  EXIT
  WATCH
}

enum RiskLevel {
  LOW
  LOW_MEDIUM
  MEDIUM
  MEDIUM_HIGH
  HIGH
  VERY_HIGH
}

enum WatchlistPriority {
  BUY_NOW
  WAIT_FOR_ENTRY
  WATCH
  SKIP_FOR_NOW
}

/// Agent/Watchlist action state (Cowork §6 / §12.8). Soft demotion uses DEMOTED/DROPPED — never hard-delete for demotion.
enum WatchlistAction {
  BUY_SUGGESTED
  EARLY_ENTRY
  DEMOTED
  DROPPED
}

enum AnalystRating {
  STRONG_BUY
  BUY
  HOLD
  SELL
  NO_COVERAGE
}

enum MarketCapBucket {
  MEGA
  LARGE
  MID
  SMALL
}

enum Sleeve {
  QUALITY_CORE
  MOMENTUM_CATALYST
  SPECULATIVE
}

enum TrendStage {
  EMERGING
  BUILDING
  HOT
  PEAKED
  FADED
  PAUSED
}

enum TrendVerdict {
  WIN
  LOSS
  ONGOING
  TOO_EARLY
}

enum WeekMomentum {
  ACCELERATING
  STABLE
  DECELERATING
  REVERSED
}

enum DiscoveredVia {
  DAILY_SCAN
  WEEKLY_SCAN
  MONTHLY_SURVEY
  MANUAL
}

/// Notion Trade Tracker Type options (Aug 2026): BUY / SELL / ADD / TRIM / STOP LOSS.
enum TradeType {
  BUY
  ADD
  TRIM
  SELL
  STOP_LOSS
}

enum TradeStatus {
  OPEN
  PARTIAL
  CLOSED
}

/// Notion Ideas Status options (Aug 2026). "Add to Watchlist" → READY_FOR_WATCHLIST.
/// GRADUATED added from Notion; CONVICTION_BUILDING not present in Notion selects.
enum IdeaStatus {
  RESEARCHING
  READY_FOR_WATCHLIST
  HOLD_OFF
  PASS
  GRADUATED
}

/// Notion Ideas Stage options (Aug 2026 dump): Radar / Pre-buzz / Emerging / Institutionalizing / Mainstream.
enum IdeaStage {
  RADAR
  PRE_BUZZ
  EMERGING
  INSTITUTIONALIZING
  MAINSTREAM
}

/// Phase 0b: cross-table theme buckets (signed §3.2 mapping). Unmapped raw kept; theme null.
enum Theme {
  AI_INFRASTRUCTURE
  NUCLEAR_POWER
  HUMANOID_ROBOTS
  SPACE
  CRYPTO
  RETAIL_TECH
  HEALTHCARE
  FINTECH_PAYMENTS
  DEFENSE_DRONES
  MEME_SPECIAL_SIT
  /// Social / consumer internet platforms (Reddit, Meta, etc.)
  SOCIAL_PLATFORMS
  /// Biotech / GLP-1 / psychedelics / cardiometabolic
  BIOTECH_GLP1
  /// Energy / commodities / grid / electrification (non-nuclear)
  ENERGY_COMMODITIES
  /// Naval / maritime / shipbuilding
  MARITIME_SHIPBUILDING
  /// Quantum computing / deep tech
  QUANTUM
  /// Prediction markets / event contracts
  PREDICTION_MARKETS
  /// Macro / trade policy / broad rotation
  MACRO
  /// Critical minerals / rare earths / defense metals (ex-China supply)
  CRITICAL_MINERALS
}

model Portfolio {
  id               String          @id @default(cuid())
  notionId         String?         @unique
  ticker           String          @unique
  company          String?
  /// Shares from Notion Portfolio "Shares" property (not derived from trade log).
  shares           Decimal?        @db.Decimal(18, 4)
  currentPrice     Decimal?        @db.Decimal(14, 4)
  myAvgCost        Decimal?        @db.Decimal(14, 4)
  analystTarget    Decimal?        @db.Decimal(14, 4)
  upsidePct        Decimal?        @db.Decimal(8, 4)
  action           PositionAction?
  actionRaw        String?
  riskLevel        RiskLevel?
  riskLevelRaw     String?
  analystRating    AnalystRating?
  analystRatingRaw String?
  socialScore      Int?
  socialSentiment  String?
  earningsDate     DateTime?
  daysToEarnings   Int?
  stopLoss         Decimal?        @db.Decimal(14, 4)
  entryZone        String?
  /// Cowork §12.7 — price range for the next add (distinct from initial entryZone).
  addZone          String?
  /// Cowork §12.7 — thesis milestone that justifies the next add.
  nextAddTrigger   String?
  /// Long-form thesis as ReportBlock[].
  thesis           Json?
  theme            Theme?
  /// Former sectorTag string; retained for one release.
  sectorTagRaw     String?
  marketCapBucket  MarketCapBucket?
  marketCapBucketRaw String?
  sleeve           Sleeve?
  conviction       Int?
  addsUsed         Int?
  /// Long-form notes as ReportBlock[].
  notes            Json?
  /// Daily notes from the Notion page body (ReportBlock[]).
  pageNotes        Json?
  keyRisk          String?
  beatRate         String?
  impliedMove      String?
  lastPriceUpdate  DateTime?
  syncedAt         DateTime        @updatedAt

  @@index([theme])
}

model Watchlist {
  id               String            @id @default(cuid())
  notionId         String?           @unique
  ticker           String            @unique
  company          String?
  theme            Theme?
  themeRaw         String?
  sectorRaw        String?
  priority         WatchlistPriority?
  priorityRaw      String?
  /// Soft demotion / BUY signal / EARLY ENTRY (§6, §12.8). DEMOTED/DROPPED replace hard-delete.
  action           WatchlistAction?
  actionRaw        String?
  demotedAt        DateTime?
  currentPrice     Decimal?          @db.Decimal(14, 4)
  analystTarget    Decimal?          @db.Decimal(14, 4)
  bullTarget       Decimal?          @db.Decimal(14, 4)
  upsidePct        Decimal?          @db.Decimal(8, 4)
  riskLevel        RiskLevel?
  riskLevelRaw     String?
  analystRating    AnalystRating?
  analystRatingRaw String?
  socialScore      Int?
  socialPlatformBuzz String?
  earningsDate     DateTime?
  daysToEarnings   Int?
  earningsRisk     String?
  entryZone        String?
  stopLoss         Decimal?          @db.Decimal(14, 4)
  keyCatalyst      String?
  keyRisk          String?
  /// Long-form thesis as ReportBlock[].
  thesis           Json?
  /// Long-form action notes as ReportBlock[].
  actionNotes      Json?
  /// Daily notes from the Notion page body (ReportBlock[]).
  pageNotes        Json?
  beatRate         String?
  impliedMove      String?
  analystCount     Int?
  marketCapBucket  MarketCapBucket?
  marketCapBucketRaw String?
  /// Last successful price sync mark (mirrors Portfolio.lastPriceUpdate).
  lastPriceUpdate  DateTime?
  syncedAt         DateTime          @updatedAt

  @@index([priority])
  @@index([theme])
  @@index([action])
}

model Trade {
  id               String       @id @default(cuid())
  notionId         String?      @unique
  /// Future logTrade idempotency; not populated by Notion sync.
  idempotencyKey   String?      @unique
  title            String
  ticker           String?
  type             TradeType?
  typeRaw          String?
  date             DateTime?
  pricePerShare    Decimal?     @db.Decimal(14, 4)
  shares           Decimal?     @db.Decimal(18, 4)
  totalValue       Decimal?     @db.Decimal(18, 4)
  pnlDollar        Decimal?     @db.Decimal(18, 4)
  pnlPct           Decimal?     @db.Decimal(8, 4)
  status           TradeStatus?
  statusRaw        String?
  avgCostBasis     Decimal?     @db.Decimal(14, 4)
  exitReason       String?
  /// Long-form thesis at entry as ReportBlock[].
  thesisAtEntry    Json?
  /// Long-form notes as ReportBlock[].
  notes            Json?
  /// RuleVersion.id in force when the trade was logged. No branch column — the real
  /// book is LIVE-only by design; shadow trades never land here.
  ruleVersionId    Int?
  syncedAt         DateTime     @updatedAt

  @@index([ticker])
  @@index([date])
  @@index([status])
}

model Trend {
  id                     String         @id @default(cuid())
  notionId               String?        @unique
  trendName              String         @unique
  dateDiscovered         DateTime?
  representativeTickers  String?
  theme                  Theme?
  /// Former themeSector string; retained for one release.
  themeSectorRaw         String?
  lifecycleStage         TrendStage?
  lifecycleStageRaw      String?
  signalScore            Int?
  socialVelocity         Int?
  analystMomentum        Int?
  priceClustering        Int?
  fundamentalBacking     Int?
  discoveredVia          DiscoveredVia?
  discoveredViaRaw       String?
  weekMomentum           WeekMomentum?
  weekMomentumRaw        String?
  perf1m                 Decimal?       @db.Decimal(8, 4)
  perf3m                 Decimal?       @db.Decimal(8, 4)
  verdict                TrendVerdict?
  verdictRaw             String?
  similarToPastTrend     String?
  keyCatalyst            String?
  /// Long-form avoid reason as ReportBlock[].
  avoidReason            Json?
  /// Long-form notes as ReportBlock[].
  notes                  Json?
  /// Long-form retrospective as ReportBlock[].
  retrospective          Json?
  syncedAt               DateTime       @updatedAt

  @@index([lifecycleStage])
  @@index([signalScore])
  @@index([theme])
}

model Idea {
  id               String      @id @default(cuid())
  notionId         String?     @unique
  /// Notion title property "Stock / Sector".
  stockSector      String      @unique
  leadTicker       String?
  company          String?
  theme            Theme?
  themeRaw         String?
  currentPrice     Decimal?    @db.Decimal(14, 4)
  analystTarget    Decimal?    @db.Decimal(14, 4)
  upsidePct        Decimal?    @db.Decimal(8, 4)
  riskLevel        String?
  status           IdeaStatus?
  statusRaw        String?
  ideaStage        IdeaStage?
  ideaStageRaw     String?
  socialBuzz       String?
  foundVia         String?
  /// Long-form why-interesting as ReportBlock[].
  whyInteresting   Json?
  keyRisk          String?
  /// Long-form notes as ReportBlock[].
  notes            Json?
  catalystDate     DateTime?
  dateFound        DateTime?
  lastReviewed     DateTime?
  graduationDate   DateTime?
  graduationPrice  Decimal?    @db.Decimal(14, 4)
  /// Last successful price sync mark when leadTicker is quotable.
  lastPriceUpdate  DateTime?
  syncedAt         DateTime    @updatedAt

  @@index([status])
  @@index([ideaStage])
  @@index([theme])
}

enum DailyLogRoutine {
  DAILY
  EARNINGS
}

/// Cached rows from Notion Daily Logs DB (journal / briefing).
model DailyLog {
  id               String           @id @default(cuid())
  notionId         String?          @unique
  /// Typically the ISO date (`Name` column), e.g. 2026-05-14
  title            String
  logDate          DateTime?
  /// Separates Daily vs Earnings writes on the same calendar day.
  routineType      DailyLogRoutine  @default(DAILY)
  /// Long-form sections as ReportBlock[].
  marketContext    Json?
  topNews          Json?
  portfolioMove    Json?
  watchlistMove    Json?
  actionTaken      Json?
  notes            Json?
  flaggedTickers   String[]         @default([])
  alertEmailSent   Boolean?         @default(false)
  rulesVersion     String?
  /// LIVE = real routine output; CANDIDATE = shadow run under a candidate ruleset.
  branch           Branch           @default(LIVE)
  /// RuleVersion.id this row was produced under (null for pre-versioning rows).
  ruleVersionId    Int?
  syncedAt         DateTime         @updatedAt
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([logDate, routineType, branch])
  @@index([logDate])
}

enum StockReportType {
  WEEKLY
  MONTHLY
}

/// Cached weekly / monthly report pages from Notion Stock Monitor HQ (child pages).
model StockReport {
  id           String          @id @default(cuid())
  notionId     String?         @unique
  title        String
  reportType   StockReportType
  reportDate   DateTime?
  /// Normalized block tree for rendering (paragraphs, headings, tables, lists).
  content      Json
  rulesVersion String?
  /// LIVE = real routine output; CANDIDATE = shadow run under a candidate ruleset.
  branch       Branch          @default(LIVE)
  /// RuleVersion.id this row was produced under (null for pre-versioning rows).
  ruleVersionId Int?
  syncedAt     DateTime        @updatedAt

  @@unique([reportType, reportDate, branch])
  @@index([reportType])
  @@index([reportDate])
}

/// One row per calendar day (GMT+8) — total portfolio value after Notion→Neon sync.
model PortfolioSnapshot {
  /// Noon UTC on the GMT+8 calendar date (matches price-sync day boundary).
  snapshotDate    DateTime @unique
  totalValue      Decimal  @db.Decimal(18, 4)
  /// Equities mark-to-market (incl. CSPX via EODHD price in Notion).
  equitiesValue   Decimal? @db.Decimal(18, 4)
  /// CASH_USD balance from Notion.
  cashValue       Decimal? @db.Decimal(18, 4)
  /// Per-holding values: [{ key, label, value, isCash }, …]
  holdingsBreakdown Json?
  unrealizedPnl   Decimal? @db.Decimal(18, 4)
  /// vs previous snapshot day; null on first row.
  dailyReturnPct  Decimal? @db.Decimal(10, 4)
  recordedAt      DateTime @default(now())

  @@index([snapshotDate])
}

model SyncStatus {
  id            Int       @id @default(autoincrement())
  source        String    @unique
  lastRunAt     DateTime
  lastSuccessAt DateTime?
  lastError     String?
  rowCounts     Json?
}

/// Phase 3: live Stock HQ config (cash, FX, limits, thresholds, tracked tickers).
/// Rules prose lives in git `/prompts`; mutable state lives here.
model Config {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Decision Review Log (Cowork §§4, 10.5, 11.7–11.9, 12.4). Notion DB backfilled; agents write via MCP.
enum DecisionType {
  BUY
  ADD
  AVERAGE_DOWN
  HOLD
  REDUCE
  EXIT
  WAIT
  AVOID
  DO_NOT_AVERAGE_DOWN
}

enum DecisionReviewStatus {
  PENDING
  REVIEWED_1W
  REVIEWED_4W
  REVIEWED_3M
  CLOSED
}

enum DecisionVerdict {
  WIN
  LOSS
  AVOIDED_LOSS
  TOO_EARLY
  NEUTRAL
}

enum DecisionSignalQuality {
  GOOD
  MIXED
  POOR
  TOO_EARLY
}

enum DecisionPositionContext {
  PORTFOLIO
  WATCHLIST
  NEW_IDEA
  TREND
  EARNINGS
}

/// Noise attribution for a name's move: see classifyMove in src/lib/fitness/math.ts.
enum MoveClass {
  MARKET_MOVE
  THEME_MOVE
  IDIOSYNCRATIC
  INSUFFICIENT_DATA
}

/// Current read on whether a decision's original thesis still holds.
enum ThesisState {
  INTACT
  WEAKENING
  BROKEN
}

model DecisionReview {
  id                   String                    @id @default(cuid())
  notionId             String?                   @unique
  /// Agent idempotency for creates (distinct from Notion sync).
  idempotencyKey       String?                   @unique
  title                String
  ticker               String?
  decisionDate         DateTime?
  decisionType         DecisionType?
  decisionTypeRaw      String?
  positionContext      DecisionPositionContext?
  positionContextRaw   String?
  /// Current read on whether the original thesis still holds.
  thesisState          ThesisState?
  /// thesisState immediately before this write, carried for drift/history reads.
  priorThesisState     ThesisState?
  /// MARKET_MOVE / THEME_MOVE / IDIOSYNCRATIC / INSUFFICIENT_DATA — set by `breadth_classify`.
  moveClass            MoveClass?
  /// Fraction of the tracked universe moving the same direction as `ticker` at decisionSession.
  breadth              Decimal?                  @db.Decimal(6, 4)
  /// Fraction of the ticker's theme moving the same direction.
  themeBreadth         Decimal?                  @db.Decimal(6, 4)
  /// Ticker's 1-session return minus the market median return (signed fraction).
  excessMove           Decimal?                  @db.Decimal(10, 6)
  priceAtDecision      Decimal?                  @db.Decimal(14, 4)
  entryZone            String?
  stopLoss             Decimal?                  @db.Decimal(14, 4)
  target               Decimal?                  @db.Decimal(14, 4)
  convictionScore      Int?
  catalyst             String?
  catalystDate         DateTime?
  originalThesis       String?
  expectedOutcome      String?
  keyMetricToWatch     String?
  reasonForDecision    String?
  riskInvalidation     String?
  sourceSignal         String[]                  @default([])
  antiPatternTags      String[]                  @default([])
  criteriaThatWorked   String[]                  @default([])
  criteriaThatFailed   String[]                  @default([])
  reviewStatus         DecisionReviewStatus?
  reviewStatusRaw      String?
  outcome1w            String?
  outcome4w            String?
  outcome3m            String?
  return1wPct          Decimal?                  @db.Decimal(8, 4)
  return4wPct          Decimal?                  @db.Decimal(8, 4)
  return3mPct          Decimal?                  @db.Decimal(8, 4)
  finalVerdict         DecisionVerdict?
  finalVerdictRaw      String?
  signalQuality        DecisionSignalQuality?
  signalQualityRaw     String?
  executionQuality     DecisionSignalQuality?
  executionQualityRaw  String?
  lessonLearned        String?
  updateStrategy       Boolean?
  rulesVersion         String?
  /// LIVE = real decision; CANDIDATE = shadow decision under a candidate ruleset.
  branch               Branch                    @default(LIVE)
  /// RuleVersion.id this decision was made under (null for pre-versioning rows).
  ruleVersionId        Int?
  syncedAt             DateTime                  @updatedAt
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([ticker])
  @@index([decisionDate])
  @@index([reviewStatus])
  @@index([decisionType])
  @@index([branch])
}

/// Evidence source strength, weakest→strongest is T4→T1 (Cowork §9 signal-tier semantics,
/// mapped onto evidence sourcing: T1/T2 = primary-source ("tier-1/2" evidence — see
/// hasTier12Evidence in src/lib/fitness/math.ts); T3 = credible secondary reporting;
/// T4 = never sufficient alone (see EvidenceKind for the kind→tier convention).
enum EvidenceTier {
  T1
  T2
  T3
  T4
}

/// Source kind for one EvidenceItem. Conventional tier alignment (not DB-enforced):
/// T1 — FILING, EARNINGS_CALL, MANAGEMENT_GUIDANCE, PRIMARY_DATA (primary source, verifiable).
/// T2 — NEWS_REPORT, ANALYST_NOTE (credible secondary reporting on primary events).
/// T3 — SOCIAL_SENTIMENT (crowd/unverified signal).
/// T4 — PRICE_ACTION, INFERENCE, OTHER (never sufficient alone — see rules.ts).
enum EvidenceKind {
  FILING
  EARNINGS_CALL
  MANAGEMENT_GUIDANCE
  PRIMARY_DATA
  NEWS_REPORT
  ANALYST_NOTE
  SOCIAL_SENTIMENT
  PRICE_ACTION
  INFERENCE
  OTHER
}

/// Evidence cited for one DecisionReview (Commit 8 — warn-only enforcement via
/// EVIDENCE_ENFORCEMENT; see src/lib/evidence/rules.ts). Plain FK, no Prisma relation —
/// matches ShadowOrder/Counterfactual's decisionReviewId convention.
model EvidenceItem {
  id               String       @id @default(cuid())
  decisionReviewId String
  tier             EvidenceTier
  kind             EvidenceKind
  summary          String
  sourceUrl        String?
  /// When the evidence became knowable (not when it was logged).
  observedAt       DateTime
  createdAt        DateTime     @default(now())

  @@index([decisionReviewId])
}

/// Living strategy docs (Cowork Strategy Lessons Summary + Investment Style Profile).
/// Neon SoT so monthly routines can update; seeded from Notion pages.
enum ContentPageKey {
  STRATEGY_LESSONS
  INVESTMENT_STYLE
}

model ContentPage {
  key          ContentPageKey @id
  title        String
  /// ReportBlock[].
  body         Json
  notionPageId String?
  syncedAt     DateTime?
  updatedAt    DateTime       @updatedAt
}

/// Lifecycle of one entry in the cron job ledger.
enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

/// Cron dispatcher ledger — one row per (job, UTC run day).
/// The reserved `__tick` job holds the dispatcher lease for the day.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  /// UTC calendar date of the tick invocation.
  runDay     DateTime  @db.Date
  status     JobStatus
  startedAt  DateTime?
  finishedAt DateTime?
  /// Lease expiry while status is RUNNING; stale leases can be reclaimed.
  leaseUntil DateTime?
  /// Resume point for jobs that return `{ done: false }`.
  cursor     Json?
  error      String?
  /// Job-specific summary handed to later jobs / ops.
  detail     Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([job, runDay])
  @@index([runDay])
}

/// Permanent daily OHLC bar store — trading-session calendar and mark source
/// for the shadow ledger. Never overwritten in place like Portfolio.currentPrice.
model PriceHistory {
  ticker    String
  /// US session date (not the fetch timestamp).
  date      DateTime @db.Date
  open      Decimal? @db.Decimal(14, 4)
  close     Decimal  @db.Decimal(14, 4)
  adjClose  Decimal? @db.Decimal(14, 4)
  volume    BigInt?
  /// "finnhub" | "eodhd" | "stooq"
  source    String
  createdAt DateTime @default(now())

  @@id([ticker, date])
  @@index([date])
}

/// Per-ticker health of the daily price-history sync (last success/failure, streak).
model TickerPriceStatus {
  ticker              String    @id
  lastSuccessAt       DateTime?
  lastAttemptAt       DateTime?
  lastSource          String?
  lastError           String?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

// === Versioned ruleset (shadow evolution) ===
// The Stock HQ ruleset (prompts + limits) becomes database-resident and versioned so a
// later evolution engine can propose candidate versions on the CANDIDATE branch while
// LIVE keeps running the ACTIVE version. Kernel clauses stay pinned in the deployed
// bundle (src/lib/rules/kernelClauses.ts) — the DB can never relax them.

/// Lifecycle of a RuleVersion. Exactly one ACTIVE and at most one CANDIDATE per lane
/// (enforced by partial unique indexes; see scripts/apply-raw-constraints.ts).
enum RuleStatus {
  CANDIDATE
  ACTIVE
  RETIRED
  KILLED
}

/// Evolution lane a candidate belongs to. FAST = short-horizon experiments, SLOW = structural.
enum RuleLane {
  FAST
  SLOW
}

/// Who created a rule version.
enum RuleActor {
  AGENT
  HUMAN
  CRON
}

/// Which ruleset a row was produced under. LIVE is the real book; CANDIDATE is shadow-only.
enum Branch {
  LIVE
  CANDIDATE
}

/// One immutable snapshot of the whole ruleset (all five prompt files + limits).
/// `id` IS the version number — never reuse or renumber.
model RuleVersion {
  id             Int         @id @default(autoincrement())
  status         RuleStatus
  /// Null for v1 and for HUMAN-authored versions that belong to no evolution lane.
  lane           RuleLane?
  actor          RuleActor
  /// Version this one was derived from; null for v1.
  parentId       Int?
  /// { "_shared.md": "<full text>", … } — all five prompt files.
  files          Json
  /// { "_shared.md": "<sha256 hex>", … } over the exact stored text.
  fileShas       Json
  /// LimitsConfig snapshot (same shape as Config.LIMITS).
  limits         Json
  changeSummary  String?
  /// e.g. ["prompts:_shared#7", "limits:cashFloorPct"].
  changedPaths   Json?
  /// Sessions on/before this instant are excluded from any fitness comparison for
  /// this version — stamped at creation so a candidate cannot claim pre-existing history.
  evidenceCutoff DateTime?
  createdAt      DateTime    @default(now())
  activatedAt    DateTime?
  retiredAt      DateTime?

  @@index([status])
}

// === Paper-only shadow ledger (shadow evolution) ===
// Two branches keep fully independent PAPER books: LIVE mirrors the decisions the ACTIVE
// ruleset produced, CANDIDATE those of the challenger. Fills come from DecisionReview rows
// at the NEXT session's open and marks from PriceHistory closes. This accounting never
// touches Portfolio / Trade / Config cash, and nothing here can place a real order.

/// Direction of a shadow (paper) order.
enum ShadowSide {
  BUY
  SELL
}

/// Lifecycle of a shadow order. PENDING orders wait for the next session's open.
enum ShadowOrderStatus {
  PENDING
  FILLED
  REJECTED
}

/// One paper book per branch. Cash + positions here are play money, never the real book.
model ShadowBranch {
  id            String   @id @default(cuid())
  branch        Branch   @unique
  /// RuleVersion this branch's book is currently running.
  ruleVersionId Int
  /// NAV the book started (or was last reset) with.
  startNav      Decimal  @db.Decimal(18, 4)
  cash          Decimal  @db.Decimal(18, 4)
  /// Running max NAV since the last reset — drawdown input for later fitness work.
  highWaterNav  Decimal  @db.Decimal(18, 4)
  resetAt       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A paper order derived from a DecisionReview row. Filled at the NEXT session's open.
model ShadowOrder {
  id               String            @id @default(cuid())
  branchId         String
  ticker           String
  side             ShadowSide
  /// Copied from the DecisionReview for attribution (the DR row may later change).
  decisionType     DecisionType?
  decisionReviewId String?
  /// Session whose bars the decision was made on (see src/lib/shadow/sessions.ts).
  decisionSession  DateTime          @db.Date
  /// BUY: fraction of branch NAV at enqueue time. SELL: fraction of the open position
  /// to liquidate (1 = full exit) — a NAV-denominated sell cannot close a position
  /// exactly once the mark moves between enqueue and fill.
  sizeFraction     Decimal           @db.Decimal(8, 6)
  status           ShadowOrderStatus @default(PENDING)
  fillSession      DateTime?         @db.Date
  /// Always a PriceHistory `open` — never a close, never a substitute.
  fillPrice        Decimal?          @db.Decimal(14, 4)
  notional         Decimal?          @db.Decimal(18, 4)
  shares           Decimal?          @db.Decimal(18, 6)
  rejectReason     String?
  /// Sessions this order has waited without a usable open; 3 → REJECTED no_open_price.
  pendingSessions  Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// One DecisionReview may enqueue at most one order per side (null ids are manual rows).
  @@unique([branchId, decisionReviewId, side])
  @@index([branchId, status])
  @@index([decisionReviewId])
}

/// An open (or closed) paper position in one branch's book.
model ShadowPosition {
  id              String    @id @default(cuid())
  branchId        String
  ticker          String
  openedSession   DateTime  @db.Date
  closedAt        DateTime?
  shares          Decimal   @db.Decimal(18, 6)
  avgCost         Decimal   @db.Decimal(14, 4)
  lastMark        Decimal?  @db.Decimal(14, 4)
  lastMarkSession DateTime? @db.Date
  /// True when the last mark was carried forward (no bar that session).
  markStale       Boolean   @default(false)
  realizedPnl     Decimal   @default(0) @db.Decimal(18, 4)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // At most one OPEN position per (branch, ticker) — partial unique index
  // "ShadowPosition_open_unique" in scripts/apply-raw-constraints.ts.
  @@index([branchId])
}

// === Counterfactuals + fitness (shadow evolution) ===
// The fitness function scores each paper book daily. Its signature term is a SIGNED,
// unclamped avoided-loss credit: refusing a name that then fell earns credit, refusing
// one that then rose earns a debit. Every field here is a FRACTION (0.03 = 3%), never
// percentage points — nothing in this section carries a `Pct` suffix.

/// Lifecycle of a counterfactual. PENDING rows wait for their horizon session.
enum CounterfactualStatus {
  PENDING
  RESOLVED
  /// Horizon passed with no usable bar inside the forward walk — excluded from credit forever.
  UNRESOLVED
}

/// Evidence quality of a fitness snapshot. DEGRADED = too many carried (stale) marks.
enum SnapshotQuality {
  OK
  DEGRADED
}

/// What a NOT-taken decision (AVOID / WAIT / DO_NOT_AVERAGE_DOWN) would have cost or saved.
model Counterfactual {
  id               String               @id @default(cuid())
  branchId         String
  decisionReviewId String
  ticker           String
  decisionType     DecisionType
  /// Session whose bars the decision was made on (see src/lib/shadow/sessions.ts).
  decisionSession  DateTime             @db.Date
  /// Horizon length in SESSIONS — constant 63 (one quarter), counted on the session
  /// calendar so holidays cannot stretch or shorten the window.
  horizonSessions  Int
  priceAtDecision  Decimal              @db.Decimal(14, 4)
  /// Fraction of NAV the branch's ruleset WOULD have allowed for this name.
  permittedSize    Decimal              @db.Decimal(8, 6)
  /// Session actually priced at the horizon (may be up to 5 sessions past the exact one).
  horizonSession   DateTime?            @db.Date
  priceAtHorizon   Decimal?             @db.Decimal(14, 4)
  horizonReturn    Decimal?             @db.Decimal(10, 6)
  /// SIGNED: −horizonReturn × permittedSize. Never clamped, never abs().
  credit           Decimal?             @db.Decimal(10, 6)
  status           CounterfactualStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  /// One counterfactual per decision per branch — a replayed seed cannot double-count.
  @@unique([branchId, decisionReviewId])
  @@index([branchId])
  @@index([status])
}

/// One branch's fitness accounting for one session. All fractions.
model FitnessSnapshot {
  id                 String          @id @default(cuid())
  branchId           String
  session            DateTime        @db.Date
  nav                Decimal         @db.Decimal(18, 4)
  /// nav / previous snapshot's nav − 1; null on the branch's first snapshot.
  dailyIncrement     Decimal?        @db.Decimal(10, 6)
  /// Σ credits of counterfactuals newly RESOLVED since the previous snapshot. Credits are
  /// already NAV-fractions (permittedSize × return), so they sum straight into fitness.
  avoidedCreditDelta Decimal         @default(0) @db.Decimal(10, 6)
  /// CSPX close / previous session's close − 1; null when the carry exceeds 3 sessions.
  benchmarkIncrement Decimal?        @db.Decimal(10, 6)
  /// dailyIncrement + avoidedCreditDelta − turnoverDelta − benchmarkIncrement.
  fitnessIncrement   Decimal?        @db.Decimal(10, 6)
  /// Rolling 30-session fitness LEVEL (includes the window drawdown penalty); null when
  /// the window is short or the benchmark is unavailable.
  windowFitness      Decimal?        @db.Decimal(10, 6)
  /// Peak-to-trough of the branch's snapshot NAV series since its last reset.
  maxDrawdown        Decimal         @db.Decimal(8, 6)
  /// Frictional cost of this session's fills, as a fraction of NAV.
  turnoverDelta      Decimal         @default(0) @db.Decimal(10, 6)
  quality            SnapshotQuality
  staleMarks         Int
  openPositions      Int
  createdAt          DateTime        @default(now())

  @@unique([branchId, session])
  @@index([session])
}
